# Copy this file to .env and fill in your values
# The domain this server receives mail for (must be a domain YOU own,
# with its MX record pointing at this server — see README.md)
MAIL_DOMAIN=yourdomain.com

# Web/API port (the inbox website + REST API)
HTTP_PORT=3000

# SMTP port (must be 25 to receive real email from the internet)
SMTP_PORT=25
